# Optional override of the FreeSERP endpoint.
# Leave unset in the browser app. It calls same-origin /freeserp, which the dev server proxies,
# because FreeSERP sends a duplicated Access-Control-Allow-Origin header that browsers reject.
# VITE_FREESERP_BASE_URL=https://freeserp.ai/api.php

# Optional contact label sent as the FreeSERP `agent` parameter. It does not change results.
VITE_FREESERP_AGENT=AI-Radar/0.1
